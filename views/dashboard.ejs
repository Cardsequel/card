  <script>
    (function () {
      var accountCard = document.getElementById('accountCard');
      var accountCardHint = document.getElementById('accountCardHint');
      if (!accountCard || !accountCardHint) return;

      function updateCardState() {
        var isMobile = window.matchMedia('(max-width: 991px)').matches;

        if (!isMobile) {
          accountCard.classList.remove('is-flipped');
          accountCard.setAttribute('aria-pressed', 'false');
          accountCardHint.textContent = ' ';
          return;
        }

        accountCardHint.textContent = accountCard.classList.contains('is-flipped')
          ? 'Tap the card to see its front.'
          : 'Tap the card to see its back.';
      }

      function handleCardFlip() {
        if (window.matchMedia('(max-width: 991px)').matches) {
          var isFlipped = accountCard.classList.toggle('is-flipped');
          accountCard.setAttribute('aria-pressed', String(isFlipped));
          updateCardState();
        }
      }

      accountCard.addEventListener('click', handleCardFlip);
      window.addEventListener('resize', updateCardState);
      updateCardState();
    })();
  </script>

  <style>
    .account-card {
      position: relative;
      width: min(100%, 460px);
      aspect-ratio: 1.75;
      display: block;
      padding: 0;
      overflow: visible;
      border: 0;
      border-radius: 14px;
      background: transparent;
      box-shadow: 0 12px 30px rgba(32, 40, 51, .16);
      color: #111;
      cursor: pointer;
      font: inherit;
      perspective: 1000px;
      text-align: left;
      -webkit-tap-highlight-color: transparent;
    }
    .account-card:focus-visible {
      outline: 3px solid #276ef1;
      outline-offset: 5px;
    }
    .account-card__inner {
      position: absolute;
      inset: 0;
      border-radius: inherit;
      transform-style: preserve-3d;
      transition: transform .7s cubic-bezier(.2, .75, .25, 1);
    }
    .account-card.is-flipped .account-card__inner {
      transform: rotateY(180deg);
    }
    .account-card__front,
    .account-card__back {
      position: absolute;
      inset: 0;
      overflow: hidden;
      border-radius: inherit;
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
    }
    .account-card__front {
      background: #fff;
    }
    .account-card__back {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 14px 0 12px;
      background: #6eeb9d;
      transform: rotateY(180deg);
    }
    @media (min-width: 992px) {
      .account-card {
        width: 100%;
        max-width: none;
        aspect-ratio: auto;
        cursor: default;
        box-shadow: none;
        perspective: none;
      }
      .account-card__inner {
        position: relative;
        inset: auto;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.25rem;
        transform: none !important;
      }
      .account-card__front,
      .account-card__back {
        position: relative;
        inset: auto;
        width: 100%;
        height: auto;
        min-height: 0;
        aspect-ratio: 1.75;
        box-shadow: 0 12px 30px rgba(32, 40, 51, .16);
        backface-visibility: visible;
        -webkit-backface-visibility: visible;
      }
      .account-card__front {
        display: grid;
        grid-template-rows: 77% 23%;
      }
      .account-card__front .account-card__face {
        height: auto;
        min-height: 0;
        box-sizing: border-box;
      }
      .account-card__front .account-card__base {
        height: auto;
        min-height: 0;
        box-sizing: border-box;
      }
      .account-card__back {
        box-sizing: border-box;
        transform: none;
      }
      .account-card__back-footer {
        gap: 8px;
        line-height: 1.4;
      }
    }
    .account-card__magnetic-strip {
      width: 100%;
      flex: 0 0 22%;
      background: #252a2e;
    }
    .account-card__signature-row {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 0 9%;
    }
    .account-card__signature {
      display: flex;
      min-width: 0;
      height: 30px;
      flex: 1;
      align-items: center;
      padding: 0 10px;
      background: repeating-linear-gradient(transparent 0 7px, #d8d8d8 7px 8px), #fff;
      color: #555;
      font-family: cursive;
      font-size: 10px;
      font-style: italic;
    }
    .account-card__security-code {
      margin: 0;
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 1px;
      white-space: nowrap;
    }
    .account-card__back-footer {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      gap: 8px;
      padding: 0 9%;
      color: #fff;
      font-size: 16px;
      font-weight: 700;
      font-family: 'Rubik', sans-serif;
      letter-spacing: .7px;
      line-height: 1.4;
      text-transform: none;
    }
    .account-card__back-logo {
      width: 22px;
      height: 22px;
      flex: 0 0 auto;
      filter: brightness(0) invert(1);
      object-fit: contain;
    }
    .account-card__face {
      position: relative;
      display: block;
      height: 77%;
      padding: 20px 24px;
      background: #6eeb9d;
    }
    .account-card__chip {
      position: absolute;
      top: 50%;
      right: 10%;
      display: grid;
      grid-template-columns: 1fr 1fr;
      width: 48px;
      height: 36px;
      margin: 0;
      transform: translateY(-50%);
      overflow: hidden;
      border: 1px solid #9aa19c;
      border-radius: 7px;
      background: #e8e9e5;
    }
    .account-card__chip::before,
    .account-card__chip::after {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 50%;
      width: 1px;
      background: #a7ada8;
      content: "";
    }
    .account-card__chip::after {
      top: 50%;
      right: 0;
      bottom: auto;
      left: 0;
      width: auto;
      height: 1px;
    }
    .account-card__chip span {
      border: 1px solid rgba(132, 140, 134, .36);
    }
    .account-card__details {
      position: absolute;
      display: block;
      right: 24px;
      bottom: 16px;
      left: 24px;
    }
    .account-card__number {
      display: block;
      margin: 0 0 8px;
      font-size: clamp(12px, 2vw, 16px);
      font-weight: 500;
      letter-spacing: 1.5px;
      white-space: nowrap;
    }
    .account-card__holder-label,
    .account-card__expiry-label {
      display: block;
      margin: 0 0 2px;
      font-size: 8px;
      letter-spacing: .6px;
      text-transform: capitalize;
    }
    .account-card__holder {
      display: block;
      overflow: hidden;
      margin: 0;
      font-size: 11px;
      font-weight: 500;
      text-overflow: ellipsis;
      text-transform: uppercase;
      white-space: nowrap;
    }
    .account-card__base {
      display: flex;
      height: 23%;
      align-items: center;
      justify-content: space-between;
      padding: 8px 24px;
      background: #fff;
    }
    .account-card__expiry {
      margin: 0;
      font-size: 11px;
      font-weight: 600;
    }
    .account-card__brand {
      margin: 0;
      color: #212529;
      font-size: 9px;
      font-weight: 800;
      letter-spacing: .6px;
    }
    @media (max-width: 575px) {
      .account-card {
        width: 100%;
      }
      .account-card__back { padding-top: 11px; padding-bottom: 10px; }
      .account-card__signature { height: 25px; }
      .account-card__face { padding: 14px 16px; }
      .account-card__details { right: 16px; bottom: 11px; left: 16px; }
      .account-card__base { padding-right: 16px; padding-left: 16px; }
      .account-card__number { margin-bottom: 5px; letter-spacing: 1px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .account-card__inner { transition: none; }
    }
  </style>
</head>

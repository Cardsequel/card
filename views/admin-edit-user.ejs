<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title>Edit account | Cardsequel Admin</title>
  <link rel="stylesheet" href="/vendors/feather/feather.css">
  <link rel="stylesheet" href="/vendors/ti-icons/css/themify-icons.css">
  <link rel="stylesheet" href="/vendors/css/vendor.bundle.base.css">
  <link rel="stylesheet" href="/css/vertical-layout-light/style.css">
  <link rel="shortcut icon" href="/images/favicon.png">
</head>

<body>
  <div class="container-scroller">
    <nav class="navbar col-lg-12 col-12 p-0 fixed-top d-flex flex-row">
      <div class="text-center navbar-brand-wrapper d-flex align-items-center justify-content-center">
        <a class="navbar-brand brand-logo mr-5" href="/"><img src="/images/logofull.png" class="mr-2" alt="Cardsequel"/></a>
        <a class="navbar-brand brand-logo-mini" href="/"><img src="/images/logo-mini.png" alt="Cardsequel"/></a>
      </div>
      <div class="navbar-menu-wrapper d-flex align-items-center justify-content-end">
        <button class="navbar-toggler navbar-toggler align-self-center" type="button" data-toggle="minimize" aria-label="Minimize navigation">
          <span class="icon-menu"></span>
        </button>
        <ul class="navbar-nav navbar-nav-right">
          <li class="nav-item nav-profile dropdown">
            <a class="nav-link dropdown-toggle" data-toggle="dropdown" id="profileDropdown" aria-label="Account menu">
              <img src="/images/faces/user.png" alt="profile"/>
            </a>
            <div class="dropdown-menu dropdown-menu-right navbar-dropdown" aria-labelledby="profileDropdown">
              <a class="dropdown-item" href="/profile"><i class="ti-user text-primary"></i>Profile</a>
              <a class="dropdown-item" href="/users/logout"><i class="ti-power-off text-primary"></i>Logout</a>
            </div>
          </li>
        </ul>
        <button class="navbar-toggler navbar-toggler-right d-lg-none align-self-center" type="button" data-toggle="offcanvas" aria-label="Open navigation">
          <span class="icon-menu"></span>
        </button>
      </div>
    </nav>

    <div class="container-fluid page-body-wrapper">
      <% var sidebarRole = 'admin'; var activePage = '/admin/users'; %>
      <% include ./partials/dashboard-sidebar %>

      <div class="main-panel">
        <div class="content-wrapper">
          <div class="row">
            <div class="col-md-12 grid-margin">
              <h3 class="font-weight-bold">Edit account</h3>
              <h6 class="font-weight-normal mb-0">Update account details, access category, balances, and card information.</h6>
            </div>
          </div>

          <div class="row">
            <div class="col-12 grid-margin stretch-card">
              <div class="card">
                <div class="card-body">
                  <h4 class="card-title"><%= account.first_name %> <%= account.last_name %></h4>
                  <% if (success_msg && success_msg.length) { %>
                    <div class="alert alert-success" role="status"><%= success_msg[0] %></div>
                  <% } %>
                  <% if (error_msg && error_msg.length) { %>
                    <div class="alert alert-danger" role="alert"><%= error_msg[0] %></div>
                  <% } %>

                  <div class="mb-4">
                    <button
                      class="btn btn-outline-primary mr-2"
                      type="button"
                      data-toggle="modal"
                      data-target="#smtp-email-modal"
                      data-email-type="welcome">
                      Send welcome email
                    </button>
                    <button
                      class="btn btn-outline-secondary"
                      type="button"
                      data-toggle="modal"
                      data-target="#smtp-email-modal"
                      data-email-type="password-reset">
                      Send password-reset email
                    </button>
                  </div>

                  <form class="forms-sample" method="post" action="/admin/users/<%= encodeURIComponent(account._id) %>">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="search" value="<%= searchQuery %>">
                    <div class="row">
                      <div class="col-md-6 form-group">
                        <label for="first_name">First name</label>
                        <input class="form-control" id="first_name" name="first_name" type="text" maxlength="80" required value="<%= account.first_name %>">
                      </div>
                      <div class="col-md-6 form-group">
                        <label for="last_name">Last name</label>
                        <input class="form-control" id="last_name" name="last_name" type="text" maxlength="80" required value="<%= account.last_name %>">
                      </div>
                    </div>

                    <div class="row">
                      <div class="col-md-6 form-group">
                        <label for="email">Email address</label>
                        <input class="form-control" id="email" name="email" type="email" maxlength="254" required value="<%= account.email %>">
                      </div>
                      <div class="col-md-6 form-group">
                        <label for="category">Account category</label>
                        <select class="form-control" id="category" name="category" required>
                          <option value="user" <%= (account.category || 'user') === 'user' ? 'selected' : '' %>>User</option>
                          <option value="admin" <%= account.category === 'admin' ? 'selected' : '' %>>Admin</option>
                        </select>
                      </div>
                    </div>

                    <div class="row">
                      <div class="col-md-6 form-group">
                        <label for="wallet">Wallet</label>
                        <input class="form-control" id="wallet" name="wallet" type="text" maxlength="120" value="<%= account.wallet || '' %>">
                      </div>
                      <div class="col-md-6 form-group">
                        <label for="code">Account code</label>
                        <input class="form-control" id="code" name="code" type="text" maxlength="120" value="<%= account.code || '' %>">
                      </div>
                      <div class="col-md-6 form-group">
                        <label for="referalcode">Referral code</label>
                        <input class="form-control" id="referalcode" name="referalcode" type="text" maxlength="120" value="<%= account.referalcode || '' %>">
                      </div>
                    </div>

                    <h4 class="card-title mt-4">Balances and activity</h4>
                    <div class="row">
                      <div class="col-md-6 form-group">
                        <label for="availbalance">Available balance</label>
                        <input class="form-control" id="availbalance" name="availbalance" type="text" inputmode="decimal" maxlength="32" required value="<%= account.availbalance %>">
                      </div>
                      <div class="col-md-6 form-group">
                        <label for="activedeposit">Active deposit</label>
                        <input class="form-control" id="activedeposit" name="activedeposit" type="text" inputmode="decimal" maxlength="32" required value="<%= account.activedeposit %>">
                      </div>
                      <div class="col-md-6 form-group">
                        <label for="activeinvestment">Active investment</label>
                        <input class="form-control" id="activeinvestment" name="activeinvestment" type="text" inputmode="decimal" maxlength="32" required value="<%= account.activeinvestment %>">
                      </div>
                      <div class="col-md-6 form-group">
                        <label for="cashback">Cashback</label>
                        <input class="form-control" id="cashback" name="cashback" type="text" inputmode="decimal" maxlength="32" required value="<%= account.cashback %>">
                      </div>
                      <div class="col-md-6 form-group">
                        <label for="todaysspending">Today's spending</label>
                        <input class="form-control" id="todaysspending" name="todaysspending" type="text" inputmode="decimal" maxlength="32" required value="<%= account.todaysspending %>">
                      </div>
                    </div>

                    <h4 class="card-title mt-4">Card details</h4>
                    <div class="row">
                      <div class="col-md-6 form-group">
                        <label for="cardnumber">Card number</label>
                        <input class="form-control" id="cardnumber" name="cardnumber" type="text" maxlength="64" value="<%= account.cardnumber || '' %>">
                      </div>
                      <div class="col-md-2 form-group">
                        <label for="CVV">CVV</label>
                        <input class="form-control" id="CVV" name="CVV" type="text" maxlength="4" value="<%= account.CVV || '' %>">
                      </div>
                      <div class="col-md-4 form-group">
                        <label for="expirydate">Expiry date</label>
                        <input class="form-control" id="expirydate" name="expirydate" type="text" maxlength="10" value="<%= account.expirydate || '' %>">
                      </div>
                    </div>

                    <h4 class="card-title mt-4">Password reset</h4>
                    <div class="form-group">
                      <label for="new_password">Set a new password</label>
                      <input class="form-control" id="new_password" name="new_password" type="password" minlength="6" maxlength="72" autocomplete="new-password">
                      <small class="form-text text-muted">Leave blank to keep the current password. Password and password confirmation values are never shown here.</small>
                    </div>

                    <div class="form-group">
                      <label for="date">Registration date</label>
                      <input class="form-control" id="date" name="date" type="date" required value="<%= account.date && Number.isFinite(new Date(account.date).getTime()) ? new Date(account.date).toISOString().slice(0, 10) : '' %>">
                    </div>

                    <button type="submit" class="btn btn-primary mr-2">Save changes</button>
                    <a class="btn btn-light" href="/admin<%= searchQuery ? '?search=' + encodeURIComponent(searchQuery) : '' %>">Back to accounts</a>
                  </form>

                  <hr class="my-4">
                  <h4 class="card-title text-danger">Delete account</h4>
                  <p>This permanently deletes this account and its top-up and crypto-withdrawal records. This action cannot be undone.</p>
                  <form method="post" action="/admin/users/<%= encodeURIComponent(account._id) %>/delete" onsubmit="return confirm('Permanently delete this account and its top-up and crypto-withdrawal records? This cannot be undone.');">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="search" value="<%= searchQuery %>">
                    <button class="btn btn-danger" type="submit">Delete user</button>
                  </form>
                </div>
              </div>
            </div>
          </div>

          <div class="modal fade" id="smtp-email-modal" tabindex="-1" role="dialog" aria-labelledby="smtp-email-modal-title" aria-hidden="true">
            <div class="modal-dialog" role="document">
              <div class="modal-content">
                <form id="smtp-email-form" method="post" action="/admin/users/<%= encodeURIComponent(account._id) %>/send-email">
                  <div class="modal-header">
                    <h5 class="modal-title" id="smtp-email-modal-title">Send email</h5>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                      <span aria-hidden="true">&times;</span>
                    </button>
                  </div>
                  <div class="modal-body">
                    <p class="text-muted">Recipient: <%= account.first_name %> <%= account.last_name %> (<%= account.email %>)</p>
                    <p class="small">The SMTP email is used as both the login and sender address. Credentials are only used for this message and are not saved.</p>
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="search" value="<%= searchQuery %>">
                    <input type="hidden" id="smtp-email-type" name="emailType" value="">
                    <div class="form-group">
                      <label for="email-site-url">Public site URL</label>
                      <input class="form-control" id="email-site-url" name="siteUrl" type="url" maxlength="2048" placeholder="https://example.com" value="<%= siteUrl || '' %>" required>
                      <small class="form-text text-muted">Enter the public site origin only, without a path. This is used to build the reset or unsubscribe link.</small>
                    </div>
                    <div class="form-group">
                      <label for="smtp-email">SMTP email</label>
                      <input class="form-control" id="smtp-email" name="smtpEmail" type="email" maxlength="254" autocomplete="off" required>
                    </div>
                    <div class="form-group">
                      <label for="smtp-password">SMTP password</label>
                      <input class="form-control" id="smtp-password" name="smtpPassword" type="password" maxlength="1024" autocomplete="new-password" required>
                    </div>
                    <div class="form-group">
                      <label for="smtp-host">SMTP host</label>
                      <input class="form-control" id="smtp-host" name="smtpHost" type="text" maxlength="253" placeholder="smtp.example.com" autocomplete="off" required>
                    </div>
                    <div class="form-row">
                      <div class="form-group col-md-6">
                        <label for="smtp-port">Port</label>
                        <input class="form-control" id="smtp-port" name="smtpPort" type="number" min="1" max="65535" value="465" required>
                      </div>
                      <div class="form-group col-md-6">
                        <label for="smtp-secure">Secure connection</label>
                        <select class="form-control" id="smtp-secure" name="smtpSecure" required>
                          <option value="true" selected>Yes (TLS)</option>
                          <option value="false">No (STARTTLS)</option>
                        </select>
                      </div>
                    </div>
                  </div>
                  <div class="modal-footer">
                    <button class="btn btn-light" type="button" data-dismiss="modal">Cancel</button>
                    <button class="btn btn-primary" type="submit">Send email</button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/vendors/js/vendor.bundle.base.js"></script>
  <script src="/js/off-canvas.js"></script>
  <script src="/js/hoverable-collapse.js"></script>
  <script src="/js/template.js"></script>
  <script src="/js/settings.js"></script>
  <script src="/js/todolist.js"></script>
  <script>
    (function () {
      var form = document.getElementById('smtp-email-form');
      var title = document.getElementById('smtp-email-modal-title');
      var emailTypeInput = document.getElementById('smtp-email-type');

      $('#smtp-email-modal').on('show.bs.modal', function (event) {
        var emailType = event.relatedTarget.getAttribute('data-email-type');
        emailTypeInput.value = emailType;
        title.textContent = emailType === 'welcome' ? 'Send welcome email' : 'Send password-reset email';
      });

      $('#smtp-email-modal').on('hidden.bs.modal', function () {
        form.reset();
        emailTypeInput.value = '';
      });
    }());
  </script>
  <% include ./partials/chat %>
</body>

</html>

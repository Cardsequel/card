<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <meta name="description" content="<%= typeof seoDescription !== 'undefined' && seoDescription || 'Discover Cardsequel cash cards for online-wallet spending. Compare card options, explore features, and learn how to apply.' %>">
    <meta name="robots" content="<%= typeof seoRobots !== 'undefined' ? seoRobots : 'noindex, nofollow' %>">
    <% if (typeof seoCanonicalUrl !== 'undefined' && seoCanonicalUrl) { %>
    <link rel="canonical" href="<%= seoCanonicalUrl %>">
    <% } %>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Cardsequel">
    <meta property="og:title" content="<%= typeof seoTitle !== 'undefined' && seoTitle || 'Online Wallet Cards & Cash Cards | Cardsequel' %>">
    <meta property="og:description" content="<%= typeof seoDescription !== 'undefined' && seoDescription || 'Discover Cardsequel cash cards for online-wallet spending. Compare card options, explore features, and learn how to apply.' %>">
    <% if (typeof seoCanonicalUrl !== 'undefined' && seoCanonicalUrl) { %>
    <meta property="og:url" content="<%= seoCanonicalUrl %>">
    <% } %>
    <meta property="og:image" content="<%= typeof seoImageUrl !== 'undefined' && seoImageUrl || 'https://cardsequel.cc/images/logofull.png' %>">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= typeof seoTitle !== 'undefined' && seoTitle || 'Online Wallet Cards & Cash Cards | Cardsequel' %>">
    <meta name="twitter:description" content="<%= typeof seoDescription !== 'undefined' && seoDescription || 'Discover Cardsequel cash cards for online-wallet spending. Compare card options, explore features, and learn how to apply.' %>">
    <meta name="twitter:image" content="<%= typeof seoImageUrl !== 'undefined' && seoImageUrl || 'https://cardsequel.cc/images/logofull.png' %>">
    <link rel="shortcut icon" href="assets/images/logo.png" type="image/x-icon">
    <title><%= typeof seoTitle !== 'undefined' && seoTitle || 'Online Wallet Cards & Cash Cards | Cardsequel' %></title>
    <% if (typeof seoStructuredData !== 'undefined' && seoStructuredData) { %>
    <script type="application/ld+json"><%- JSON.stringify(seoStructuredData).replace(/</g, '\\u003c') %></script>
    <% } %>
  </head>
  <body>
    <div><%- body %></div>

  </body>
</html>

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <meta name="description" content="Withdraw and spend from all your online wallets and portfolio with ease.">
    <link rel="canonical" href="<%= canonicalUrl %>">
    <link rel="shortcut icon" href="assets/images/logo.png" type="image/x-icon">
    <title>Cardsequel  | A card for your wallet</title>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Cardsequel">
    <meta property="og:title" content="Cardsequel  | A card for your wallet">
    <meta property="og:description" content="Withdraw and spend from all your online wallets and portfolio with ease.">
    <meta property="og:url" content="<%= canonicalUrl %>">
    <meta property="og:image" content="<%= siteUrl %>/images/logofull.png">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Cardsequel  | A card for your wallet">
    <meta name="twitter:description" content="Withdraw and spend from all your online wallets and portfolio with ease.">
    <meta name="twitter:image" content="<%= siteUrl %>/images/logofull.png">
    <script type="application/ld+json"><%- JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Organization',
          name: 'Cardsequel',
          url: `${siteUrl}/`,
          logo: `${siteUrl}/images/logofull.png`
        },
        {
          '@type': 'WebSite',
          name: 'Cardsequel',
          url: `${siteUrl}/`
        },
        {
          '@type': 'WebPage',
          name: 'Cardsequel  | A card for your wallet',
          description: 'Withdraw and spend from all your online wallets and portfolio with ease.',
          url: canonicalUrl,
          isPartOf: {
            '@type': 'WebSite',
            name: 'Cardsequel',
            url: `${siteUrl}/`
          }
        }
      ]
    }).replace(/</g, '\\u003c') %></script>
  </head>
  <body>
    <div><%- body %></div>

  </body>
</html>

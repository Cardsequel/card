<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title>Admin dashboard | Cardsequel</title>
  <link rel="stylesheet" href="/vendors/feather/feather.css">
  <link rel="stylesheet" href="/vendors/ti-icons/css/themify-icons.css">
  <link rel="stylesheet" href="/vendors/css/vendor.bundle.base.css">
  <link rel="stylesheet" href="/css/vertical-layout-light/style.css">
  <link rel="shortcut icon" href="/images/favicon.png">
</head>

<body>
  <div class="container-scroller">
    <nav class="navbar col-lg-12 col-12 p-0 fixed-top d-flex flex-row">
      <div class="text-center navbar-brand-wrapper d-flex align-items-center justify-content-center">
        <a class="navbar-brand brand-logo mr-5" href="/"><img src="/images/logofull.png" class="mr-2" alt="Cardsequel"/></a>
        <a class="navbar-brand brand-logo-mini" href="/"><img src="/images/logo-mini.png" alt="Cardsequel"/></a>
      </div>
      <div class="navbar-menu-wrapper d-flex align-items-center justify-content-end">
        <button class="navbar-toggler navbar-toggler align-self-center" type="button" data-toggle="minimize" aria-label="Minimize navigation">
          <span class="icon-menu"></span>
        </button>
        <ul class="navbar-nav navbar-nav-right">
          <li class="nav-item nav-profile dropdown">
            <a class="nav-link dropdown-toggle" data-toggle="dropdown" id="profileDropdown" aria-label="Account menu">
              <img src="/images/faces/user.png" alt="profile"/>
            </a>
            <div class="dropdown-menu dropdown-menu-right navbar-dropdown" aria-labelledby="profileDropdown">
              <a class="dropdown-item" href="/profile"><i class="ti-user text-primary"></i>Profile</a>
              <a class="dropdown-item" href="/users/logout"><i class="ti-power-off text-primary"></i>Logout</a>
            </div>
          </li>
        </ul>
        <button class="navbar-toggler navbar-toggler-right d-lg-none align-self-center" type="button" data-toggle="offcanvas" aria-label="Open navigation">
          <span class="icon-menu"></span>
        </button>
      </div>
    </nav>

    <div class="container-fluid page-body-wrapper">
      <% var sidebarRole = 'admin'; var activePage = '/admin-dashboard'; %>
      <% include ./partials/dashboard-sidebar %>

      <div class="main-panel">
        <div class="content-wrapper">
          <div class="row">
            <div class="col-md-12 grid-margin">
              <h3 class="font-weight-bold">Admin dashboard</h3>
              <h6 class="font-weight-normal mb-0">Welcome back, <%= user.first_name %>. Here’s an overview of user accounts and activity.</h6>
            </div>
          </div>

          <% if (success_msg && success_msg.length) { %>
            <div class="alert alert-success" role="status"><%= success_msg[0] %></div>
          <% } %>
          <% if (error_msg && error_msg.length) { %>
            <div class="alert alert-danger" role="alert"><%= error_msg[0] %></div>
          <% } %>
          <% if (invalidMetrics && invalidMetrics.length) { %>
            <div class="alert alert-warning" role="alert">
              Some account amounts could not be included in these totals because they are not valid decimal amounts:
              <%= invalidMetrics.map(metric => `${metric.label}: ${metric.count}`).join(', ') %>.
              Correct those account values in Accounts before relying on the totals.
            </div>
          <% } %>

          <div class="row">
            <div class="col-lg-12 grid-margin transparent">
              <div class="row">
                <div class="col-md-4 mb-4 stretch-card transparent">
                  <div class="card data-icon-card-primary">
                    <div class="card-body">
                      <p class="mb-4">Total accounts</p>
                      <p class="fs-30 mb-2"><%= metrics.totalAccounts.toLocaleString(numberLocale) %></p>
                    </div>
                  </div>
                </div>
                <div class="col-md-4 mb-4 stretch-card transparent">
                  <div class="card card-inverse-success">
                    <div class="card-body">
                      <p class="mb-4">V1 accounts</p>
                      <p class="fs-30 mb-2"><%= metrics.standardAccounts.toLocaleString(numberLocale) %></p>
                    </div>
                  </div>
                </div>
                <div class="col-md-4 mb-4 stretch-card transparent">
                  <div class="card data-icon-card-primary">
                    <div class="card-body">
                      <p class="mb-4">Administrators</p>
                      <p class="fs-30 mb-2"><%= metrics.adminAccounts.toLocaleString(numberLocale) %></p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="row">
            <div class="col-lg-12 grid-margin transparent">
              <div class="row">
                <div class="col-md-12 col-xl-6 mb-4 stretch-card transparent">
                  <div class="card data-icon-card-primary">
                    <div class="card-body">
                      <p class="mb-4">Available balances</p>
                      <p class="fs-30 mb-2"><%= metrics.availableBalance %></p>
                    </div>
                  </div>
                </div>
                <div class="col-md-6 col-xl-3 mb-4 stretch-card transparent">
                  <div class="card data-icon-card-primary">
                    <div class="card-body">
                      <p class="mb-4">Active deposits</p>
                      <p class="fs-30 mb-2"><%= metrics.activeDeposits %></p>
                    </div>
                  </div>
                </div>
                <div class="col-md-6 col-xl-3 mb-4 stretch-card transparent">
                  <div class="card data-icon-card-primary">
                    <div class="card-body">
                      <p class="mb-4">Active investments</p>
                      <p class="fs-30 mb-2"><%= metrics.activeInvestments %></p>
                    </div>
                  </div>
                </div>
                <div class="col-md-6 col-xl-3 mb-4 stretch-card transparent">
                  <div class="card card-inverse-success">
                    <div class="card-body">
                      <p class="mb-4">Cashback</p>
                      <p class="fs-30 mb-2"><%= metrics.cashback %></p>
                    </div>
                  </div>
                </div>
                <div class="col-md-6 col-xl-3 mb-4 stretch-card transparent">
                  <div class="card card-inverse-success">
                    <div class="card-body">
                      <p class="mb-4">Today's spending</p>
                      <p class="fs-30 mb-2"><%= metrics.todaysSpending %></p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="row">
            <div class="col-12 grid-margin stretch-card">
              <div class="card">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-center flex-wrap">
                    <div>
                      <h4 class="card-title">Recently registered accounts</h4>
                      <p class="card-description">The five newest user accounts</p>
                    </div>
                    <a class="btn btn-primary mb-3" href="/admin">Manage accounts</a>
                  </div>
                  <div class="table-responsive">
                    <table class="table table-hover">
                      <thead>
                        <tr>
                          <th>Account</th>
                          <th>Email</th>
                          <th>Category</th>
                          <th>Joined</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% if (recentUsers.length) { %>
                          <% recentUsers.forEach(account => { %>
                            <tr>
                              <td><%= account.first_name %> <%= account.last_name %></td>
                              <td><%= account.email %></td>
                              <td>
                                <label class="badge <%= account.category === 'admin' ? 'badge-success' : 'badge-light' %>">
                                  <%= account.category || 'user' %>
                                </label>
                              </td>
                              <td><%= account.date ? new Date(account.date).toLocaleDateString() : 'Unknown' %></td>
                            </tr>
                          <% }); %>
                        <% } else { %>
                          <tr>
                            <td colspan="4" class="text-center">No accounts have been registered yet.</td>
                          </tr>
                        <% } %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/vendors/js/vendor.bundle.base.js"></script>
  <script src="/js/off-canvas.js"></script>
  <script src="/js/hoverable-collapse.js"></script>
  <script src="/js/template.js"></script>
  <script src="/js/settings.js"></script>
  <script src="/js/todolist.js"></script>
  <% include ./partials/chat %>
</body>

</html>

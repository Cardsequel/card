<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title>Crypto withdrawal | Cardsequel</title>
  <link rel="stylesheet" href="/vendors/feather/feather.css">
  <link rel="stylesheet" href="/vendors/ti-icons/css/themify-icons.css">
  <link rel="stylesheet" href="/vendors/css/vendor.bundle.base.css">
  <link rel="stylesheet" href="/css/vertical-layout-light/style.css">
  <link rel="shortcut icon" href="/images/favicon.png">
</head>
<body>
  <div class="container-scroller">
    <nav class="navbar col-lg-12 col-12 p-0 fixed-top d-flex flex-row">
      <div class="text-center navbar-brand-wrapper d-flex align-items-center justify-content-center">
        <a class="navbar-brand brand-logo mr-5" href="/"><img src="/images/logofull.png" class="mr-2" alt="Cardsequel"></a>
        <a class="navbar-brand brand-logo-mini" href="/"><img src="/images/logo-mini.png" alt="Cardsequel"></a>
      </div>
      <div class="navbar-menu-wrapper d-flex align-items-center justify-content-end">
        <ul class="navbar-nav navbar-nav-right">
          <li class="nav-item nav-profile dropdown">
            <a class="nav-link dropdown-toggle" data-toggle="dropdown" id="profileDropdown" aria-label="Account menu"><img src="/images/faces/user.png" alt="profile"></a>
            <div class="dropdown-menu dropdown-menu-right navbar-dropdown" aria-labelledby="profileDropdown">
              <a class="dropdown-item" href="/profile"><i class="ti-user text-primary"></i>Profile</a>
              <a class="dropdown-item" href="/users/logout"><i class="ti-power-off text-primary"></i>Logout</a>
            </div>
          </li>
        </ul>
        <button class="navbar-toggler navbar-toggler-right d-lg-none align-self-center" type="button" data-toggle="offcanvas" aria-label="Open navigation"><span class="icon-menu"></span></button>
      </div>
    </nav>

    <div class="container-fluid page-body-wrapper">
      <% var sidebarRole = 'user'; var activePage = '/withdrawal'; %>
      <% include ./partials/dashboard-sidebar %>

      <div class="main-panel">
        <div class="content-wrapper">
          <div class="row">
            <div class="col-md-12 grid-margin">
              <h3 class="font-weight-bold">Withdraw cryptocurrency</h3>
              <h6 class="font-weight-normal mb-0">Request a withdrawal to an external wallet.</h6>
            </div>
          </div>

          <% if (success_msg && success_msg.length) { %><div class="alert alert-success" role="status"><%= success_msg[0] %></div><% } %>
          <% if (error_msg && error_msg.length) { %><div class="alert alert-danger" role="alert"><%= error_msg[0] %></div><% } %>

            <div class="row">
            <div class="col-lg-12 col-md-12 grid-margin transparent">
              <div class="row">
                <div class="col-md-6 mb-4 stretch-card transparent">
                  <div class="card data-icon-card-primary">
                    <div class="card-body">
                      <p class="mb-4">Card Balance</p>
                      <p class="fs-30 mb-2">$ <%= Number(user.availbalance || 0).toLocaleString(numberLocale, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></p>
                     
                    </div>
                  </div>
                </div>
                <div class="col-md-6 mb-4 stretch-card transparent">
                  <div class="card data-icon-card-primary">
                    <div class="card-body">
                      <p class="mb-4">Card Active Deposit</p>
                      <p class="fs-30 mb-2">$ <%= Number(user.activedeposit || 0).toLocaleString(numberLocale, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></p>
                      
                    </div>
                  </div>
                </div>
                <div class="col-md-6 mb-4 stretch-card transparent">
                  <div class="card card-inverse-success">
                    <div class="card-body">
                      <p class="mb-4">Card Spending</p>
                      <p class="fs-30 mb-2">$ <%= Number(user.activeinvestment || 0).toLocaleString(numberLocale, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></p>
                      
                    </div>
                  </div>
                </div>
              </div>
          </div>
            <div class="col-lg-7 grid-margin stretch-card">
              <div class="card">
                <div class="card-body">
                  <h4 class="card-title">New withdrawal request</h4>
                  <p class="card-description">Enter the amount to withdraw in USD. The crypto amount will be determined when the request is processed.</p>
                  <p class="text-muted">Available assets: Bitcoin (BTC), Ethereum (ETH), Tether (USDT), USD Coin (USDC), BNB, and XRP.</p>
                  <form id="crypto-withdrawal-form" method="post" action="/withdrawal">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="form-group">
                      <label for="amount">Amount (USD)</label>
                      <input class="form-control" id="amount" name="amount" type="number" min="0.01" max="999999999999" step="0.01" required>
                    </div>
                    <div class="form-group">
                      <label for="asset">Cryptocurrency</label>
                      <select class="form-control" id="asset" name="asset" required>
                        <option value="">Select a cryptocurrency</option>
                        <% cryptoAssets.forEach(asset => { %>
                          <option value="<%= asset.symbol %>" data-default-network="<%= asset.defaultNetwork || '' %>"><%= asset.name %> (<%= asset.symbol %>)</option>
                        <% }); %>
                      </select>
                    </div>
                    <div class="form-group" id="network-group" hidden>
                      <label for="network">Network</label>
                      <select class="form-control" id="network" name="network">
                        <option value="">Select a network</option>
                        <% cryptoAssets.forEach(asset => { %>
                          <% asset.networks.forEach(network => { %>
                            <option value="<%= network.value %>" data-asset="<%= asset.symbol %>"><%= network.label %></option>
                          <% }); %>
                        <% }); %>
                      </select>
                      <small class="form-text text-muted">Choose the same network that your destination wallet uses.</small>
                    </div>
                    <div class="form-group">
                      <label for="walletAddress">Destination wallet address</label>
                      <input class="form-control" id="walletAddress" name="walletAddress" type="text" minlength="8" maxlength="200" autocomplete="off" spellcheck="false" required>
                      <small class="form-text" id="walletAddressFeedback" aria-live="polite">Select an asset and network, then enter a matching wallet address.</small>
                      <small class="form-text text-muted">Make sure the wallet supports the selected asset and network.</small>
                    </div>
                    <button class="btn btn-primary" type="submit">Submit withdrawal request</button>
                  </form>
                </div>
              </div>
            </div>
          </div>

          <div class="row">
            <div class="col-12 grid-margin stretch-card">
              <div class="card">
                <div class="card-body">
                  <h4 class="card-title">Your withdrawal requests</h4>
                  <div class="table-responsive">
                    <table class="table table-hover">
                      <thead>
                        <tr><th>Submitted</th><th>Amount (USD)</th><th>Asset</th><th>Network</th><th>Destination wallet</th><th>Status</th></tr>
                      </thead>
                      <tbody>
                        <% if (requests.length) { %>
                          <% requests.forEach(request => { %>
                            <tr>
                              <td><%= new Date(request.createdAt).toLocaleString() %></td>
                              <td>$<%= Number(request.amount).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                              <td><%= request.asset %></td>
                              <td><%= request.network %></td>
                              <td class="text-break"><%= request.walletAddress %></td>
                              <td><label class="badge <%= request.status === 'approved' ? 'badge-success' : request.status === 'rejected' ? 'badge-danger' : 'badge-warning' %>"><%= request.status %></label></td>
                            </tr>
                          <% }); %>
                        <% } else { %>
                          <tr><td colspan="6" class="text-center">You have not submitted a withdrawal request yet.</td></tr>
                        <% } %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script src="/vendors/js/vendor.bundle.base.js"></script>
  <script src="/js/off-canvas.js"></script>
  <script src="/js/hoverable-collapse.js"></script>
  <script src="/js/template.js"></script>
  <script src="/js/crypto-address-validation.js"></script>
  <script src="/js/crypto-withdrawal-form.js"></script>
  <% include ./partials/chat %>
</body>
</html>
